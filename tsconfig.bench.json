{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    // Catches real type errors in the JS bench scripts without requiring JSDoc
    // on every parameter.
    "noImplicitAny": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["bench/**/*.ts", "bench/**/*.tsx", "bench/**/*.mjs"]
}

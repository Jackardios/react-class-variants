{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["@testing-library/jest-dom"]
  },
  "include": [
    "src",
    "test/**/*.spec.ts",
    "test/**/*.spec.tsx",
    "test/setup.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test/**/*.test-d.ts",
    "test/**/*.test-d.tsx"
  ]
}

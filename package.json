{
  "name": "react-class-variants",
  "version": "2.0.0-alpha.5",
  "description": "Type-safe React variants API for dynamic CSS class composition",
  "private": false,
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vitest",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:types": "pnpm run build && pnpm run test:types:contracts && pnpm run test:types:exports && pnpm run test:types:consumers",
    "test:types:contracts": "tsd --files test/types/contracts/**/*.test-d.tsx",
    "test:types:exports": "attw --pack .",
    "test:types:consumers": "node scripts/test-types-consumers.mjs",
    "check:changeset": "node scripts/check-changeset.cjs",
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "lint": "tsc --project tsconfig.build.json",
    "lint:all": "tsc --project tsconfig.test.json",
    "lint:eslint": "eslint src test --max-warnings=0",
    "lint:format": "prettier --check .",
    "lint:pkg": "publint",
    "format": "prettier --write .",
    "bench": "vitest bench",
    "verify": "pnpm run lint && pnpm run lint:all && pnpm run lint:eslint && pnpm run lint:format && pnpm run test && pnpm run test:types && pnpm run lint:pkg",
    "ci": "pnpm run check:changeset && pnpm run verify",
    "release": "pnpm run verify && changeset publish",
    "verify:release-publication": "node scripts/verify-release-publication.mjs",
    "sync:prerelease-dist-tag": "node scripts/sync-prerelease-dist-tag.mjs"
  },
  "license": "MIT",
  "author": {
    "name": "Salavat Salakhutdinov",
    "email": "salahutdinov.salavat@gmail.com",
    "url": "https://github.com/Jackardios"
  },
  "keywords": [
    "react",
    "variants",
    "css",
    "classnames",
    "class-variance",
    "tailwind",
    "tailwindcss",
    "css-modules",
    "styled-components",
    "typescript",
    "polymorphic",
    "compound-variants"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jackardios/react-class-variants.git"
  },
  "bugs": {
    "url": "https://github.com/Jackardios/react-class-variants/issues"
  },
  "homepage": "https://github.com/Jackardios/react-class-variants#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@changesets/cli": "^2.29.6",
    "@eslint/js": "^9.39.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "class-variance-authority": "^0.7.1",
    "classname-variants": "^1.7.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "prettier": "2.8.8",
    "publint": "^0.3.18",
    "react-dom": "^19.1.1",
    "tsd": "^0.33.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.53.1",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "^19.0"
  }
}
